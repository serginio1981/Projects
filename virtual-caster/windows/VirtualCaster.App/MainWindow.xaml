<Window x:Class="VirtualCaster.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VirtualCaster.App"
        Title="VirtualCaster" Width="1240" Height="860" MinWidth="900" MinHeight="640"
        Background="#0E0E0E" Foreground="#E8E8E8" FontFamily="Segoe UI" Closed="OnClosed">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#F5A623" />

        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Foreground" Value="#C8C8C8" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,2,0,2" />
        </Style>
        <Style TargetType="TextBlock" x:Key="DeviceLabel">
            <Setter Property="Foreground" Value="#B0B0B0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="3,4,0,2" />
        </Style>

        <!-- Botón de goma retroiluminado: tenue apagado, brillante encendido. El color va en Background. -->
        <Style TargetType="ToggleButton" x:Key="Cap">
            <Setter Property="Width" Value="76" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#101010" />
            <Setter Property="Background" Value="#35E06A" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7" Opacity="0.38"
                                BorderBrush="#000000" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.55" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.15" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pad blanco del SOUNDPAD. -->
        <Style TargetType="Button" x:Key="Pad">
            <Setter Property="Margin" Value="5" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#303030" />
            <Setter Property="Background" Value="#F2F2F2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7"
                                BorderBrush="#000000" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F5A623" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón de goma de acción (no conmutable): siempre iluminado. -->
        <Style TargetType="Button" x:Key="CapAction">
            <Setter Property="Width" Value="76" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#101010" />
            <Setter Property="Background" Value="#35E06A" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7" Opacity="0.85"
                                BorderBrush="#000000" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">
        <!-- Conexiones (equivale al panel trasero de la consola) -->
        <Border DockPanel.Dock="Top" Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="0" Text="Micrófono 1" Style="{StaticResource DeviceLabel}" />
                <TextBlock Grid.Column="1" Text="Canal" Style="{StaticResource DeviceLabel}" />
                <TextBlock Grid.Column="2" Text="Micrófono 2 / instrumento" Style="{StaticResource DeviceLabel}" />
                <TextBlock Grid.Column="3" Text="Canal" Style="{StaticResource DeviceLabel}" />
                <TextBlock Grid.Column="4" Text="Música (AUX IN)" Style="{StaticResource DeviceLabel}" />
                <TextBlock Grid.Column="5" Text="Audio del sistema (LOOP BACK)" Style="{StaticResource DeviceLabel}" />
                <ComboBox Grid.Row="1" Grid.Column="0" x:Name="cbMic1" Margin="3" DisplayMemberPath="Name" />
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="cbMic1Ch" Margin="3" />
                <ComboBox Grid.Row="1" Grid.Column="2" x:Name="cbMic2" Margin="3" DisplayMemberPath="Name" />
                <ComboBox Grid.Row="1" Grid.Column="3" x:Name="cbMic2Ch" Margin="3" />
                <ComboBox Grid.Row="1" Grid.Column="4" x:Name="cbMusic" Margin="3" DisplayMemberPath="Name" />
                <ComboBox Grid.Row="1" Grid.Column="5" x:Name="cbLoop" Margin="3" DisplayMemberPath="Name" />
                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="Audífonos (HEADPHONES / MONITOR)" Style="{StaticResource DeviceLabel}" />
                <TextBlock Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Text="Transmisión (STREAM OUT → cable virtual)" Style="{StaticResource DeviceLabel}" />
                <ComboBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" x:Name="cbPhones" Margin="3" DisplayMemberPath="Name" />
                <ComboBox Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" x:Name="cbStream" Margin="3" DisplayMemberPath="Name" />
                <StackPanel Grid.Row="3" Grid.Column="4" Orientation="Horizontal">
                    <Button x:Name="btnStart" Content="▶ Encender" Margin="3" Padding="14,2" Click="OnStartStop" FontWeight="Bold" />
                    <Button Content="↻ Actualizar" Margin="3" Padding="10,2" Click="OnRefreshDevices" ToolTip="Vuelve a leer la lista de dispositivos de audio." />
                </StackPanel>
                <TextBlock Grid.Row="3" Grid.Column="5" x:Name="txtStatus" Text="Apagada" VerticalAlignment="Center" Margin="8,0" Foreground="{StaticResource Accent}" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!-- Cuerpo de la consola: tamaño fijo, escalado para ajustarse a la ventana -->
        <Viewbox Stretch="Uniform">
            <Border Width="1160" Height="620" CornerRadius="26" BorderBrush="#3A3A3A" BorderThickness="2" Padding="26,20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#2A2A2A" Offset="0" />
                        <GradientStop Color="#161616" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="290" />
                    </Grid.ColumnDefinitions>

                    <!-- Izquierda: MUSIC, faders y mute -->
                    <StackPanel Grid.Column="0">
                        <local:Knob x:Name="slMusic" Width="170" Height="170" Minimum="0" Maximum="1" Value="0.7" DefaultValue="0.7" ValueChanged="OnParam" />
                        <Grid Width="170" Margin="0,-4,0,0">
                            <TextBlock Text="MIN" Style="{StaticResource Label}" HorizontalAlignment="Left" />
                            <TextBlock Text="MUSIC" Style="{StaticResource Label}" FontSize="13" />
                            <TextBlock Text="MAX" Style="{StaticResource Label}" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <local:Fader x:Name="slFader1" Width="80" Height="250" Minimum="0" Maximum="1" Value="0.8" DefaultValue="0.8" ValueChanged="OnParam" />
                                <ToggleButton x:Name="tgMute1" Content="MUTE 1" Style="{StaticResource Cap}" Background="#FF453A" Click="OnParam" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <local:Fader x:Name="slFader2" Width="80" Height="250" Minimum="0" Maximum="1" Value="0.8" DefaultValue="0.8" ValueChanged="OnParam" />
                                <ToggleButton x:Name="tgMute2" Content="MUTE 2" Style="{StaticResource Cap}" Background="#FF453A" Click="OnParam" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Centro: perillas, medidores, botones y soundpad -->
                    <Grid Grid.Column="1" Margin="14,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <UniformGrid Rows="1">
                            <StackPanel><local:Knob x:Name="slGain1" Width="60" Height="60" Minimum="-20" Maximum="20" Value="0" ValueChanged="OnParam" /><TextBlock Text="GAIN 1" Style="{StaticResource Label}" /></StackPanel>
                            <StackPanel><local:Knob x:Name="slGain2" Width="60" Height="60" Minimum="-20" Maximum="20" Value="0" ValueChanged="OnParam" /><TextBlock Text="GAIN 2" Style="{StaticResource Label}" /></StackPanel>
                            <StackPanel><local:Knob x:Name="slLow" Width="60" Height="60" Minimum="-10" Maximum="10" Value="0" ValueChanged="OnParam" /><TextBlock Text="LOW" Style="{StaticResource Label}" /></StackPanel>
                            <StackPanel><local:Knob x:Name="slMid" Width="60" Height="60" Minimum="-10" Maximum="10" Value="0" ValueChanged="OnParam" /><TextBlock Text="MID" Style="{StaticResource Label}" /></StackPanel>
                            <StackPanel><local:Knob x:Name="slHigh" Width="60" Height="60" Minimum="-10" Maximum="10" Value="0" ValueChanged="OnParam" /><TextBlock Text="HI" Style="{StaticResource Label}" /></StackPanel>
                            <StackPanel><local:Knob x:Name="slPhones" Width="60" Height="60" Minimum="0" Maximum="1" Value="0.7" DefaultValue="0.7" ValueChanged="OnParam" /><TextBlock Text="HEADPHONE" Style="{StaticResource Label}" /></StackPanel>
                        </UniformGrid>
                        <Border Grid.Row="1" Background="#0C0C0C" CornerRadius="8" Padding="0,10,0,4" Margin="0,10,0,0">
                            <UniformGrid Rows="1">
                                <StackPanel><local:LedMeter x:Name="mMusic" Width="18" Height="150" /><TextBlock Text="MUSIC" Style="{StaticResource Label}" /></StackPanel>
                                <StackPanel><local:LedMeter x:Name="m1" Width="18" Height="150" /><TextBlock Text="1" Style="{StaticResource Label}" /></StackPanel>
                                <StackPanel><local:LedMeter x:Name="m2" Width="18" Height="150" /><TextBlock Text="2" Style="{StaticResource Label}" /></StackPanel>
                                <StackPanel><local:LedMeter x:Name="mPad" Width="18" Height="150" /><TextBlock Text="SOUNDPAD" Style="{StaticResource Label}" /></StackPanel>
                                <StackPanel><local:LedMeter x:Name="mPhones" Width="18" Height="150" /><TextBlock Text="HEADPHONES" Style="{StaticResource Label}" /></StackPanel>
                                <StackPanel><local:LedMeter x:Name="mOut" Width="18" Height="150" /><TextBlock Text="OUTPUT" Style="{StaticResource Label}" /></StackPanel>
                            </UniformGrid>
                        </Border>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <ToggleButton Content="48V" Style="{StaticResource Cap}" Background="#F2F2F2" IsEnabled="False" ToolTip="No aplica: la alimentación phantom la entrega la interfaz de audio física." />
                            <ToggleButton Content="48V" Style="{StaticResource Cap}" Background="#F2F2F2" IsEnabled="False" ToolTip="No aplica: la alimentación phantom la entrega la interfaz de audio física." />
                            <ToggleButton Content="BT" Style="{StaticResource Cap}" Background="#4A90FF" IsEnabled="False" ToolTip="Fase 2: entrada de audio Bluetooth." />
                            <ToggleButton x:Name="tgMonitor" Content="MONITOR" Style="{StaticResource Cap}" Background="#4A90FF" Click="OnParam" />
                            <ToggleButton Content="AUTO-TUNE" Style="{StaticResource Cap}" Background="#F2F2F2" IsEnabled="False" ToolTip="Fase 2: corrección de afinación." />
                        </StackPanel>
                        <DockPanel Grid.Row="3" Margin="0,4,0,0">
                            <TextBlock DockPanel.Dock="Top" Text="SOUNDPAD  ·  clic: reproducir / detener  ·  clic derecho: cargar archivo" Style="{StaticResource Label}" Foreground="{StaticResource Accent}" />
                            <UniformGrid x:Name="padGrid" Rows="2" Columns="4" />
                        </DockPanel>
                    </Grid>

                    <!-- Derecha: OUTPUT y efectos -->
                    <StackPanel Grid.Column="2">
                        <Grid>
                            <TextBlock Text="VirtualCaster" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Top" />
                            <local:Knob x:Name="slOutput" Width="170" Height="170" Minimum="0" Maximum="1" Value="0.8" DefaultValue="0.8" ValueChanged="OnParam" />
                        </Grid>
                        <Grid Width="170" Margin="0,-4,0,0">
                            <TextBlock Text="MIN" Style="{StaticResource Label}" HorizontalAlignment="Left" />
                            <TextBlock Text="OUTPUT" Style="{StaticResource Label}" FontSize="13" />
                            <TextBlock Text="MAX" Style="{StaticResource Label}" HorizontalAlignment="Right" />
                        </Grid>
                        <UniformGrid Rows="1" Margin="0,16,0,0">
                            <StackPanel><local:Knob x:Name="slPadVol" Width="60" Height="60" Minimum="0" Maximum="1" Value="0.7" DefaultValue="0.7" ValueChanged="OnParam" /><TextBlock Text="PAD VOL" Style="{StaticResource Label}" /></StackPanel>
                            <StackPanel ToolTip="Fase 2: cambio de tono de la voz."><local:Knob Width="60" Height="60" Minimum="-12" Maximum="12" Value="0" IsEnabled="False" /><TextBlock Text="PITCH" Style="{StaticResource Label}" /></StackPanel>
                            <StackPanel ToolTip="En el mínimo la reverberación queda desactivada."><local:Knob x:Name="slReverb" Width="60" Height="60" Minimum="0" Maximum="1" Value="0" ValueChanged="OnParam" /><TextBlock Text="REVERB" Style="{StaticResource Label}" /></StackPanel>
                        </UniformGrid>
                        <UniformGrid Columns="3" Margin="0,14,0,0" HorizontalAlignment="Center">
                            <Button x:Name="btnPreset" Style="{StaticResource CapAction}" Background="#35E06A" Click="OnPreset" ToolTip="Recorre los 6 presets de reverberación.">
                                <TextBlock x:Name="txtPreset" Text="REVERB&#10;Hall" TextAlignment="Center" />
                            </Button>
                            <ToggleButton x:Name="tgSide" Style="{StaticResource Cap}" Background="#4A90FF" Click="OnParam" ToolTip="Baja la música automáticamente mientras hablas.">
                                <TextBlock Text="SIDE&#10;CHAIN" TextAlignment="Center" />
                            </ToggleButton>
                            <ToggleButton x:Name="tgSing" Style="{StaticResource Cap}" Background="#FF453A" Click="OnSing" ToolTip="Quita la voz de la música. Primera pulsación: solo en la transmisión. Segunda: también en audífonos. Tercera: apagado.">
                                <TextBlock x:Name="txtSing" Text="SING&#10;ALONG" TextAlignment="Center" />
                            </ToggleButton>
                            <ToggleButton x:Name="tgDry" Style="{StaticResource Cap}" Background="#35E06A" Click="OnDry" ToolTip="WET: la transmisión lleva los efectos. DRY: la transmisión recibe la voz sin efectos.">
                                <TextBlock x:Name="txtDry" Text="DRY/WET&#10;wet" TextAlignment="Center" />
                            </ToggleButton>
                            <ToggleButton x:Name="tgLoop" Style="{StaticResource Cap}" Background="#4A90FF" Click="OnParam" ToolTip="Incluye el audio del sistema en la transmisión.">
                                <TextBlock Text="LOOP&#10;BACK" TextAlignment="Center" />
                            </ToggleButton>
                            <ToggleButton x:Name="tgNoise" Style="{StaticResource Cap}" Background="#FF453A" Click="OnNoise" ToolTip="Reducción de ruido: apagado → bajo → alto.">
                                <TextBlock x:Name="txtNoise" Text="NOISE&#10;REDUCER" TextAlignment="Center" />
                            </ToggleButton>
                        </UniformGrid>
                    </StackPanel>
                </Grid>
            </Border>
        </Viewbox>
    </DockPanel>
</Window>
