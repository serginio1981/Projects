<Window x:Class="VirtualCaster.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VirtualCaster" Width="1180" Height="760" MinWidth="1000" MinHeight="700"
        Background="#151515" Foreground="#E8E8E8" FontFamily="Segoe UI" Closed="OnClosed">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#F5A623" />
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Foreground" Value="#B0B0B0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,4,0,2" />
        </Style>
        <Style TargetType="Border" x:Key="Panel">
            <Setter Property="Background" Value="#202020" />
            <Setter Property="BorderBrush" Value="#333" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="6" />
        </Style>
        <Style TargetType="ToggleButton">
            <Setter Property="Width" Value="92" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="Minimum" Value="-60" />
            <Setter Property="Maximum" Value="0" />
            <Setter Property="Value" Value="-60" />
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="170" />
            <Setter Property="Foreground" Value="#35C759" />
            <Setter Property="Background" Value="#101010" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="8">
        <!-- Dispositivos (equivale al panel trasero de la consola) -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Panel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="0" Text="Micrófono 1" Style="{StaticResource Label}" />
                <TextBlock Grid.Column="1" Text="Canal" Style="{StaticResource Label}" />
                <TextBlock Grid.Column="2" Text="Micrófono 2 / instrumento" Style="{StaticResource Label}" />
                <TextBlock Grid.Column="3" Text="Canal" Style="{StaticResource Label}" />
                <TextBlock Grid.Column="4" Text="Música (AUX IN)" Style="{StaticResource Label}" />
                <TextBlock Grid.Column="5" Text="Audio del sistema (LOOP BACK)" Style="{StaticResource Label}" />
                <ComboBox Grid.Row="1" Grid.Column="0" x:Name="cbMic1" Margin="3" DisplayMemberPath="Name" />
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="cbMic1Ch" Margin="3" />
                <ComboBox Grid.Row="1" Grid.Column="2" x:Name="cbMic2" Margin="3" DisplayMemberPath="Name" />
                <ComboBox Grid.Row="1" Grid.Column="3" x:Name="cbMic2Ch" Margin="3" />
                <ComboBox Grid.Row="1" Grid.Column="4" x:Name="cbMusic" Margin="3" DisplayMemberPath="Name" />
                <ComboBox Grid.Row="1" Grid.Column="5" x:Name="cbLoop" Margin="3" DisplayMemberPath="Name" />
                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="Audífonos (HEADPHONES / MONITOR)" Style="{StaticResource Label}" />
                <TextBlock Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Text="Transmisión (STREAM OUT → cable virtual)" Style="{StaticResource Label}" />
                <ComboBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" x:Name="cbPhones" Margin="3" DisplayMemberPath="Name" />
                <ComboBox Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" x:Name="cbStream" Margin="3" DisplayMemberPath="Name" />
                <Button Grid.Row="3" Grid.Column="4" x:Name="btnStart" Content="▶ Encender" Margin="3" Click="OnStartStop" FontWeight="Bold" />
                <TextBlock Grid.Row="3" Grid.Column="5" x:Name="txtStatus" Text="Apagada" VerticalAlignment="Center" Margin="8,0" Foreground="{StaticResource Accent}" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- MUSIC + faders + mute -->
            <Border Grid.RowSpan="2" Style="{StaticResource Panel}">
                <StackPanel Width="210">
                    <TextBlock Text="MUSIC" Style="{StaticResource Label}" />
                    <Slider x:Name="slMusic" Minimum="0" Maximum="1" Value="0.7" ValueChanged="OnParam" />
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="FADER 1" Style="{StaticResource Label}" />
                            <Slider x:Name="slFader1" Orientation="Vertical" Height="220" HorizontalAlignment="Center" Minimum="0" Maximum="1" Value="0.8" TickPlacement="Both" TickFrequency="0.1" ValueChanged="OnParam" />
                            <ToggleButton x:Name="tgMute1" Content="MUTE 1" Click="OnParam" />
                            <ToggleButton Content="48V" IsEnabled="False" ToolTip="No aplica: la alimentación phantom la entrega la interfaz de audio física." />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="FADER 2" Style="{StaticResource Label}" />
                            <Slider x:Name="slFader2" Orientation="Vertical" Height="220" HorizontalAlignment="Center" Minimum="0" Maximum="1" Value="0.8" TickPlacement="Both" TickFrequency="0.1" ValueChanged="OnParam" />
                            <ToggleButton x:Name="tgMute2" Content="MUTE 2" Click="OnParam" />
                            <ToggleButton Content="48V" IsEnabled="False" ToolTip="No aplica: la alimentación phantom la entrega la interfaz de audio física." />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Perillas superiores + medidores -->
            <Border Grid.Column="1" Style="{StaticResource Panel}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <UniformGrid Rows="1">
                        <StackPanel Margin="4"><TextBlock Text="GAIN 1 (dB)" Style="{StaticResource Label}" /><Slider x:Name="slGain1" Minimum="-20" Maximum="20" Value="0" ValueChanged="OnParam" /></StackPanel>
                        <StackPanel Margin="4"><TextBlock Text="GAIN 2 (dB)" Style="{StaticResource Label}" /><Slider x:Name="slGain2" Minimum="-20" Maximum="20" Value="0" ValueChanged="OnParam" /></StackPanel>
                        <StackPanel Margin="4"><TextBlock Text="LOW" Style="{StaticResource Label}" /><Slider x:Name="slLow" Minimum="-10" Maximum="10" Value="0" ValueChanged="OnParam" /></StackPanel>
                        <StackPanel Margin="4"><TextBlock Text="MID" Style="{StaticResource Label}" /><Slider x:Name="slMid" Minimum="-10" Maximum="10" Value="0" ValueChanged="OnParam" /></StackPanel>
                        <StackPanel Margin="4"><TextBlock Text="HI" Style="{StaticResource Label}" /><Slider x:Name="slHigh" Minimum="-10" Maximum="10" Value="0" ValueChanged="OnParam" /></StackPanel>
                        <StackPanel Margin="4"><TextBlock Text="HEADPHONE" Style="{StaticResource Label}" /><Slider x:Name="slPhones" Minimum="0" Maximum="1" Value="0.7" ValueChanged="OnParam" /></StackPanel>
                    </UniformGrid>
                    <UniformGrid Grid.Row="1" Rows="1" Margin="0,10,0,0">
                        <StackPanel><ProgressBar x:Name="mMusic" /><TextBlock Text="MUSIC" Style="{StaticResource Label}" /></StackPanel>
                        <StackPanel><ProgressBar x:Name="m1" /><TextBlock Text="1" Style="{StaticResource Label}" /></StackPanel>
                        <StackPanel><ProgressBar x:Name="m2" /><TextBlock Text="2" Style="{StaticResource Label}" /></StackPanel>
                        <StackPanel><ProgressBar x:Name="mPad" /><TextBlock Text="SOUNDPAD" Style="{StaticResource Label}" /></StackPanel>
                        <StackPanel><ProgressBar x:Name="mPhones" /><TextBlock Text="HEADPHONES" Style="{StaticResource Label}" /></StackPanel>
                        <StackPanel><ProgressBar x:Name="mOut" /><TextBlock Text="OUTPUT" Style="{StaticResource Label}" /></StackPanel>
                    </UniformGrid>
                </Grid>
            </Border>

            <!-- SOUNDPAD -->
            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Panel}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center">
                        <ToggleButton Content="BT" IsEnabled="False" ToolTip="Fase 2: entrada de audio Bluetooth." />
                        <ToggleButton x:Name="tgMonitor" Content="MONITOR" Click="OnParam" />
                        <ToggleButton Content="AUTO-TUNE" IsEnabled="False" ToolTip="Fase 2: corrección de afinación." />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="SOUNDPAD — clic: reproducir/detener · clic derecho: cargar archivo" Style="{StaticResource Label}" />
                    <UniformGrid x:Name="padGrid" Rows="2" Columns="4" />
                </DockPanel>
            </Border>

            <!-- OUTPUT + efectos -->
            <Border Grid.Column="2" Grid.RowSpan="2" Style="{StaticResource Panel}">
                <StackPanel Width="210">
                    <TextBlock Text="OUTPUT" Style="{StaticResource Label}" />
                    <Slider x:Name="slOutput" Minimum="0" Maximum="1" Value="0.8" ValueChanged="OnParam" />
                    <TextBlock Text="PAD VOL" Style="{StaticResource Label}" Margin="0,14,0,2" />
                    <Slider x:Name="slPadVol" Minimum="0" Maximum="1" Value="0.7" ValueChanged="OnParam" />
                    <TextBlock Text="PITCH (fase 2)" Style="{StaticResource Label}" />
                    <Slider IsEnabled="False" Minimum="-12" Maximum="12" Value="0" />
                    <TextBlock Text="REVERB" Style="{StaticResource Label}" />
                    <Slider x:Name="slReverb" Minimum="0" Maximum="1" Value="0" ValueChanged="OnParam" ToolTip="En el mínimo la reverberación queda desactivada." />
                    <UniformGrid Columns="2" Margin="0,14,0,0">
                        <Button x:Name="btnPreset" Content="REVERB: Hall" Height="44" Margin="4" FontSize="11" FontWeight="SemiBold" Click="OnPreset" />
                        <ToggleButton x:Name="tgSide" Content="SIDE CHAIN" Click="OnParam" />
                        <ToggleButton x:Name="tgDry" Content="DRY (sin efectos)" Click="OnParam" ToolTip="Activado: la transmisión recibe la voz sin efectos (DRY). Desactivado: con efectos (WET)." />
                        <Button x:Name="btnSing" Content="SING ALONG: off" Height="44" Margin="4" FontSize="11" FontWeight="SemiBold" Click="OnSing" />
                        <ToggleButton x:Name="tgLoop" Content="LOOP BACK" Click="OnParam" />
                        <Button x:Name="btnNoise" Content="NOISE RED.: off" Height="44" Margin="4" FontSize="11" FontWeight="SemiBold" Click="OnNoise" />
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
